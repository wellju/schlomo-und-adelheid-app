{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Read(//**/Context/**)",
      "Read(~/Documents/Schlomo-Rohdaten/**)",
      "Read(//**/*.docx)",
      "Read(//**/*.doc)",
      "Read(//**/*.dotx)",
      "Read(//**/*.xlsx)",
      "Read(//**/*.xls)",
      "Read(//**/*.pdf)",
      "Read(//**/*.jpg)",
      "Read(//**/*.jpeg)",
      "Read(//**/*.png)",
      "Read(//**/*.heic)",
      "mcp__terminal",
      "mcp__Claude_Browser",
      "mcp__computer-use",
      "mcp__claude-in-chrome",
      "mcp__PDF_Tools",
      "mcp__plugin_pdf-viewer_pdf",
      "mcp__plugin_playwright_playwright",
      "mcp__scheduled-tasks",
      "mcp__visualize",
      "mcp__ccd_session",
      "mcp__ccd_session_mgmt",
      "mcp__ccd_directory",
      "mcp__ccd_host",
      "SendMessage"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": [
    "engine"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ENGINE_EXE}}",
            "args": [
              "hook"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
