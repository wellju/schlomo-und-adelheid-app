{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fallpaket.schema.json",
  "title": "Fallpaket (Austausch App zu Claude, Browser-Variante)",
  "description": "Von der App nach der Freigabe erzeugt; die Engine lässt die Erkennung vor dem Export erneut laufen. Je Art nur die erlaubten Felder. Nie enthalten: interne Diagnose, diagnosebezogene Regeln (awmf_*), Schweregrad, Dateinamen, Klardaten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paket_id",
    "art",
    "session_id",
    "erwartete_rueckgabe",
    "anonymisierung_geprueft",
    "inhalt"
  ],
  "$defs": {
    "kurztext": {
      "type": "string",
      "maxLength": 20000
    },
    "kategorien": {
      "type": "array",
      "description": "Von der Engine abgeleitete Kategorien je Wert; Claude übernimmt sie unverändert.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wert_quelle"
        ],
        "properties": {
          "wert_quelle": {
            "type": "string",
            "pattern": "^/"
          },
          "kategorie": {
            "type": "string",
            "maxLength": 200
          },
          "kategorie_luecke": {
            "type": "string",
            "maxLength": 500
          }
        },
        "oneOf": [
          {
            "required": [
              "kategorie"
            ]
          },
          {
            "required": [
              "kategorie_luecke"
            ]
          }
        ]
      }
    },
    "bausteine": {
      "type": "array",
      "description": "Feste Verfahrensbausteine aus dem Testkatalog.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testkatalog_id",
          "text",
          "zitat"
        ],
        "properties": {
          "testkatalog_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          },
          "zitat": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "paket_id": {
      "type": "string",
      "pattern": "^p-[0-9a-f]{8}$"
    },
    "art": {
      "enum": [
        "gutachten",
        "pruefung_stil",
        "pruefung_goldfisch",
        "pruefung_elefant",
        "diagnosevorschlag",
        "stil_lernen",
        "hypothese",
        "intervision",
        "supervision",
        "protokoll_elefant",
        "protokoll_goldfisch"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^s-[0-9a-f]{8}$"
    },
    "erwartete_rueckgabe": {
      "enum": [
        "gutachten-output",
        "befunde",
        "diagnosevorschlag",
        "stilprofil",
        "protokoll-intervision",
        "protokoll-supervision"
      ]
    },
    "anonymisierung_geprueft": {
      "const": true,
      "description": "Die Engine hat die Erkennung unmittelbar vor dem Export ohne Fund durchlaufen."
    },
    "konfiguration_version": {
      "type": "string"
    },
    "inhalt": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "art": {
            "const": "gutachten"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "gutachten-output"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gutachten_input",
              "regelergebnis",
              "vorlage"
            ],
            "properties": {
              "gutachten_input": {
                "$ref": "gutachten-input.schema.json"
              },
              "regelergebnis": {
                "$ref": "regelergebnis.schema.json#/$defs/fuer_claude"
              },
              "vorlage": {
                "$ref": "vorlage.schema.json#/$defs/fuer_claude"
              },
              "stilprofil": {
                "$ref": "stilprofil.schema.json#/$defs/fuer_claude"
              },
              "kategorien": {
                "$ref": "#/$defs/kategorien"
              },
              "bausteine": {
                "$ref": "#/$defs/bausteine"
              },
              "lernbausteine": {
                "$ref": "lernbausteine.schema.json#/$defs/fuer_claude",
                "description": "Freigegebene Lernbausteine für dieses Ziel (Task 5); ändern nie Regeln, Grenzwerte oder Wortlaute."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "pruefung_stil"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "befunde"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entwurf",
              "stilprofil"
            ],
            "properties": {
              "entwurf": {
                "$ref": "gutachten-output.schema.json"
              },
              "stilprofil": {
                "$ref": "stilprofil.schema.json#/$defs/fuer_claude"
              },
              "lernbausteine": {
                "$ref": "lernbausteine.schema.json#/$defs/fuer_claude",
                "description": "Freigegebene Lernbausteine für dieses Ziel (Task 5); ändern nie Regeln, Grenzwerte oder Wortlaute."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "pruefung_goldfisch"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "befunde"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fragestellung",
              "ergebnis_text",
              "kriterien"
            ],
            "properties": {
              "fragestellung": {
                "$ref": "#/$defs/kurztext"
              },
              "ergebnis_text": {
                "type": "string",
                "maxLength": 100000,
                "description": "Entwurfstext ohne Quellenreferenzen und ohne Eingaben."
              },
              "kriterien": {
                "$ref": "#/$defs/kurztext"
              },
              "gutachtentyp": {
                "enum": [
                  "spf",
                  "lrs",
                  "rechenstoerung",
                  "emotional_soziale_entwicklung"
                ],
                "description": "Nur damit der Goldfisch bei spf wertende Sprache besonders gewichtet (Nachtrag 1)."
              },
              "lernbausteine": {
                "$ref": "lernbausteine.schema.json#/$defs/fuer_claude",
                "description": "Freigegebene Lernbausteine für dieses Ziel (Task 5); ändern nie Regeln, Grenzwerte oder Wortlaute."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "pruefung_elefant"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "befunde"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gutachten_input",
              "entwurf",
              "regelergebnis"
            ],
            "properties": {
              "gutachten_input": {
                "$ref": "gutachten-input.schema.json"
              },
              "entwurf": {
                "$ref": "gutachten-output.schema.json"
              },
              "regelergebnis": {
                "$ref": "regelergebnis.schema.json#/$defs/fuer_claude"
              },
              "kategorien": {
                "$ref": "#/$defs/kategorien"
              },
              "bausteine": {
                "$ref": "#/$defs/bausteine"
              },
              "lernbausteine": {
                "$ref": "lernbausteine.schema.json#/$defs/fuer_claude",
                "description": "Freigegebene Lernbausteine für dieses Ziel (Task 5); ändern nie Regeln, Grenzwerte oder Wortlaute."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "diagnosevorschlag"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "diagnosevorschlag"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gutachten_input"
            ],
            "description": "Eigenes, neues Gespräch ohne Entwurf; die interne Diagnose ist nie enthalten.",
            "properties": {
              "gutachten_input": {
                "allOf": [
                  {
                    "$ref": "gutachten-input.schema.json"
                  },
                  {
                    "not": {
                      "required": [
                        "gutachten_diagnose"
                      ]
                    }
                  }
                ],
                "description": "Blind: ohne die Diagnose der Psychologin (Nachtrag 1, Diagnosevergleich)."
              },
              "kategorien": {
                "$ref": "#/$defs/kategorien"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "stil_lernen"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "stilprofil"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "probetexte"
            ],
            "properties": {
              "probetexte": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "probe_id",
                    "text"
                  ],
                  "properties": {
                    "probe_id": {
                      "type": "string",
                      "pattern": "^pg-[0-9a-f]{8}$"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 100000,
                      "description": "Freigegebener, anonymisierter Text eines Probegutachtens."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "hypothese"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "befunde"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vignette",
              "schlussfolgerung"
            ],
            "properties": {
              "vignette": {
                "$ref": "#/$defs/kurztext"
              },
              "schlussfolgerung": {
                "$ref": "#/$defs/kurztext"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "intervision"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "protokoll-intervision"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hinweise",
              "berater_perspektiven"
            ],
            "properties": {
              "hinweise": {
                "description": "Hinweis-Wortlaute aus konfiguration/hinweise.json, null wenn nicht hinterlegt.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kindeswohl",
                      "akute_gefaehrdung"
                    ],
                    "properties": {
                      "kindeswohl": {
                        "$ref": "#/$defs/kurztext"
                      },
                      "akute_gefaehrdung": {
                        "$ref": "#/$defs/kurztext"
                      }
                    }
                  }
                ]
              },
              "berater_perspektiven": {
                "description": "Aus konfiguration/berater.json, null wenn nicht hinterlegt.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "berater.schema.json#/properties/perspektiven"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "supervision"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "protokoll-supervision"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hinweise",
              "haltung",
              "haltung_version"
            ],
            "properties": {
              "hinweise": {
                "description": "Hinweis-Wortlaute aus konfiguration/hinweise.json, null wenn nicht hinterlegt.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kindeswohl",
                      "akute_gefaehrdung"
                    ],
                    "properties": {
                      "kindeswohl": {
                        "$ref": "#/$defs/kurztext"
                      },
                      "akute_gefaehrdung": {
                        "$ref": "#/$defs/kurztext"
                      }
                    }
                  }
                ]
              },
              "haltung": {
                "description": "wissensbasis/haltung.md, null wenn nicht hinterlegt.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/kurztext"
                  }
                ]
              },
              "haltung_version": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "protokoll_elefant"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "befunde"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protokoll"
            ],
            "description": "Elefant im Browser: das zurückgegebene Intervisionsprotokoll in Phase abschluss.",
            "properties": {
              "protokoll": {
                "$ref": "protokoll-intervision.schema.json"
              },
              "lernbausteine": {
                "$ref": "lernbausteine.schema.json#/$defs/fuer_claude",
                "description": "Freigegebene Lernbausteine aus Intervision für diesen Prüfer (Task 5)."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "art": {
            "const": "protokoll_goldfisch"
          }
        }
      },
      "then": {
        "properties": {
          "erwartete_rueckgabe": {
            "const": "befunde"
          },
          "inhalt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modus",
              "mitnahme"
            ],
            "description": "Goldfisch im Browser: nur Schlüsselfrage bzw. Anliegen, Methode, Beiträge bzw. Hypothesen und Mitnahme, von der Engine aus dem Protokoll gebildet.",
            "properties": {
              "modus": {
                "enum": [
                  "intervision",
                  "supervision"
                ]
              },
              "schluesselfrage": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/kurztext"
                  }
                ]
              },
              "anliegen": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/kurztext"
                  }
                ]
              },
              "methode": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "beitraege": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/kurztext"
                }
              },
              "hypothesen": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/kurztext"
                }
              },
              "mitnahme": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/kurztext"
                  }
                ]
              },
              "lernbausteine": {
                "$ref": "lernbausteine.schema.json#/$defs/fuer_claude",
                "description": "Freigegebene Lernbausteine aus Intervision für diesen Prüfer (Task 5)."
              }
            }
          }
        }
      }
    }
  ]
}
