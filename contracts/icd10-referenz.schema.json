{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icd10-referenz.schema.json",
  "title": "ICD-10-Referenzdaten (lokal)",
  "description": "Lokale, versionierte Kopie der Klassifikation ICD-10 BMASGPK aus der DIAGLIST. Import durch die Psychologin oder den Nutzer aus der offiziellen Datei; Lizenz und Weitergabe im Spike prüfen. Kein Abruf zur Laufzeit. Tests nutzen eine synthetische Liste mit herkunft synthetisch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "quelle",
    "herkunft",
    "codes"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "version": {
      "type": "string",
      "description": "z. B. Ausgabejahr der DIAGLIST."
    },
    "quelle": {
      "type": "string",
      "minLength": 1
    },
    "herkunft": {
      "enum": [
        "offiziell",
        "synthetisch"
      ]
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "titel"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}(\\.[0-9]{1,2})?$"
          },
          "titel": {
            "type": "string"
          }
        }
      }
    }
  }
}
