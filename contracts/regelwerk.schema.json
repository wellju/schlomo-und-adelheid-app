{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelwerk.schema.json",
  "title": "Regelwerk Fachregeln",
  "description": "Versionierte Fachregeln. Die Logik liegt im Code, regel_id verweist auf die Implementierung. Hier stehen Parameter, Quelle und Status. Für /verbessern gesperrt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "regeln"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "version": {
      "type": "string"
    },
    "regeln": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regel_id",
          "version",
          "gutachtentyp",
          "titel",
          "beschreibung",
          "quelle",
          "status",
          "parameter"
        ],
        "properties": {
          "regel_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "gutachtentyp": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "spf",
                "lrs",
                "rechenstoerung",
                "emotional_soziale_entwicklung"
              ]
            },
            "description": "Gutachtentypen, für die die Regel gilt."
          },
          "wirkung": {
            "enum": [
              "blockiert_diagnose",
              "blockiert_export",
              "hinweis"
            ],
            "description": "Folge eines nicht erfüllten Ergebnisses, z. B. Regel c: hinweis (Nachtrag 1)."
          },
          "version": {
            "type": "string"
          },
          "titel": {
            "type": "string"
          },
          "beschreibung": {
            "type": "string"
          },
          "quelle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dokument",
              "fassung"
            ],
            "properties": {
              "dokument": {
                "type": "string",
                "description": "z. B. AWMF S2k 028-042"
              },
              "fassung": {
                "type": "string"
              },
              "fundstelle": {
                "type": "string",
                "description": "Kapitel oder Empfehlung, bis zur Prüfung am Original leer."
              }
            }
          },
          "status": {
            "enum": [
              "entwurf",
              "freigegeben",
              "ausser_kraft"
            ]
          },
          "freigabe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "durch"
            ],
            "properties": {
              "durch": {
                "const": "psychologin"
              },
              "kommentar": {
                "type": "string"
              }
            }
          },
          "parameter": {
            "type": "object",
            "description": "Regelspezifisch, z. B. {\"iq_ki_obergrenze_max\": 69}. Schema je regel_id im Code."
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "freigegeben"
            }
          }
        },
        "then": {
          "required": [
            "freigabe"
          ]
        }
      }
    }
  }
}
