{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lernsignal.schema.json",
  "title": "Lernsignal",
  "description": "Entsteht beim Annehmen oder Verwerfen eines Befunds oder bei einer Textänderung der Psychologin. /verbessern braucht mindestens drei Signale je Vorschlag. Bewertungslogik ist als Bereich nicht vorgesehen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "herkunft", "art", "bereich", "konfiguration_version"],
  "properties": {
    "schema_version": { "const": "1" },
    "herkunft": { "enum": ["gutachten", "intervision"], "description": "Supervision fließt nie in Lernvorschläge." },
    "signal_id": { "type": "string", "pattern": "^ls-[0-9a-f]{8}$" },
    "art": { "enum": ["befund_angenommen", "befund_verworfen", "text_geaendert"] },
    "bereich": { "enum": ["sprache", "struktur", "pruefverhalten"] },
    "pruefer": { "enum": ["elefant", "goldfisch", "stil", null] },
    "befund_id": { "type": "string" },
    "abschnitt_id": { "type": "string" },
    "vorher": { "type": "string", "maxLength": 500, "description": "Anonymisierter Ausschnitt." },
    "nachher": { "type": "string", "maxLength": 500, "description": "Anonymisierter Ausschnitt." },
    "kommentar": { "type": "string" },
    "konfiguration_version": { "type": "string" },
    "verwendet_in_vorschlag": { "type": ["string", "null"] }
  }
}
