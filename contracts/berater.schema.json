{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "berater.schema.json",
  "title": "Berater-Perspektiven",
  "description": "konfiguration/berater.json: Perspektiven, aus denen die Psychologin in der Intervision Berater wählt (Nachtrag 1, darunter Mehrsprachigkeit und DaZ).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "herkunft", "perspektiven"],
  "properties": {
    "schema_version": { "const": "1" },
    "version": { "type": "string", "minLength": 1 },
    "herkunft": { "enum": ["synthetisch", "psychologin"] },
    "perspektiven": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "beschreibung"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "beschreibung": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
